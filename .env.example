# Copy to .env (git-ignored). `make lab-seed` writes a real one for the lab.

# Organisation API key (Organisation settings > API Keys). Inside view + approved fixes.
# Use a dedicated key; read-only is enough for audits. This is the READ key: audits,
# ci, watch, plan, report, parity and the MCP server load it and nothing else.
GATECRASHER_ORG_API_KEY=

# Optional WRITE key, used only to apply and roll back fixes. Only `gatecrasher serve`
# and the interactive terminal commands (apply, rollback, fix-all, run by a person at a
# real terminal) load it. The MCP server, audit, ci, watch, plan, report and parity never
# do, so a coding agent's process never holds it. If unset, writes fall back to
# GATECRASHER_ORG_API_KEY and `serve` prints a note that the keys are not split.
# Self-hosted Flagsmith may not support restricted organisation keys; the split still
# keeps the write key out of agent processes.
GATECRASHER_WRITE_API_KEY=

# Server-side environment keys (ser.…) per environment, comma-separated. Optional:
# the environment document is read with the org key when these are absent.
GATECRASHER_SERVER_KEYS=Production=,Development=

# Client-side environment keys per environment. Optional: recon discovers them.
GATECRASHER_CLIENT_KEYS=

# Overrides flagsmith.api_url from gatecrasher.yaml.
GATECRASHER_API_URL=

# Anthropic API key. Without it Gatecrasher runs in clearly labelled "AI off" mode.
ANTHROPIC_API_KEY=
GATECRASHER_MODEL=claude-sonnet-5-5
# Or use a signed-in Claude Code CLI instead of an API key: claude-code | api | off
GATECRASHER_AI=

# Webhook signing secret for watch mode (generated if empty).
GATECRASHER_WEBHOOK_SECRET=

# Optional Slack incoming-webhook URL for watch alerts.
GATECRASHER_SLACK_WEBHOOK_URL=
