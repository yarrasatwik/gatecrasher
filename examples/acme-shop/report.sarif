          "ruleId": "EXPERIMENT_RIGGING",
          "ruleIndex": 4,
          "level": "error",
          "message": {
            "text": "Visitors can choose their own price in the pricing test: Anyone with the public client key can send any identifier they like and see which price variant it receives. By trying identifiers until they land in the low-price group, they can switch from price_high to price_low. Roughly half of the identifiers tried (50.5%) landed in the low-price group."
          },
          "partialFingerprints": {
            "gatecrasherFindingId/v1": "GC-DED120AC"
