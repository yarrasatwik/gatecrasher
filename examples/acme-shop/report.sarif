      "results": [
        {
          "ruleId": "IDENTIFIER_FORGERY",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Anyone can switch on internal tools by typing a staff-style email: The production flag service decides who gets internal_tools based on the identifier a visitor supplies. Any identifier matching the staff pattern, such as a@acmeshop.dev, flips internal_tools from off to on. The client key is enough to try it, and no trait or login is involved."
          },
          "partialFingerprints": {
            "gatecrasherFindingId/v1": "GC-32B2A0B1"
          },
          "locations": [
